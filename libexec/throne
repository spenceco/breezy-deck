#!/bin/bash
# The stereo skybox viewer (the person on the throne) fullscreen in the
# glasses, with head tracking. Breezy draws a single view, so in the glasses'
# 3D mode its scene can't be stereo; this hands the glasses' screen to a
# browser instead and gives the viewer the head pose Breezy would have used.
#   breezy throne <viewer-url>   remember the viewer's address, then start
#   breezy throne                start, or stop if it's running (the shortcut)
#   breezy throne stop
#   breezy throne check          why the glasses won't switch to 3D (diagnostics)
# It switches the glasses to 3D on the way in and back to 2D on the way out,
# with a double-press of R1 (see set_dimension).
# While it runs: turn your head to look around; double-tap the glasses (or R)
# to recenter; double-click to cycle 2D/3D if it's wrong; Ctrl+Q leaves. Breezy's effect is unloaded meanwhile (which drops its virtual
# screens); on the way out it's loaded again, the screens come back (as many
# as before) and the windows go back where they were.
libexec=$(dirname "$(readlink -f "$0")")
CONF=$HOME/.config/breezy-throne-url
PORT=8770
IMU=/dev/shm/breezy_desktop_imu
WORK=${XDG_RUNTIME_DIR:-/tmp}/breezy-throne
PROFILE=$HOME/.var/app/org.mozilla.firefox/breezy-throne-profile
STRIP_HEIGHT=600  # the widget strip, as in "screens"

kwin() { gdbus call --session --dest org.kde.KWin --object-path "$1" --method "$2" "${@:3}"; }
running() { pgrep -f "breezy-throne-profile|throne-server" >/dev/null; }
stop() { pkill -f -- "breezy-throne-profile"; }
note() { echo "$*"; notify-send -a "Breezy" -i video-display "Throne viewer" "$*" 2>/dev/null || true; }

case $1 in
    stop) stop; exit ;;
    check) exec "$libexec/throne-check" ;;
    http://* | https://*) echo "$1" > "$CONF"; echo "Viewer address saved." ;;
    "") running && { stop; exit; } ;;
    *) echo "usage: breezy throne [<viewer-url> | stop | check]" >&2; exit 2 ;;
esac
running && { echo "Already running (breezy throne stop)."; exit 0; }

url=$(cat "$CONF" 2>/dev/null)
[[ -n $url ]] || { echo "First give the viewer's address: breezy throne <url>" >&2; exit 2; }
# The driver refreshes the pose block many times a second while the glasses are on.
if [[ ! -f $IMU ]] || (( $(date +%s) - $(stat -c %Y "$IMU") > 5 )); then
    note "No head tracking from the glasses: are they connected, with Breezy on?"
    exit 1
fi

# The glasses' row of screens (their own screen and the virtual screens level
# with it; not the Deck's screen or the widget strip), as in "screens".
row_count() {
    timeout 10 kscreen-doctor -o 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | awk -v sh=$STRIP_HEIGHT '
        /^Output:/ { if (n && e) print n, g; n = $3; e = 0; g = "" }
        $1 == "enabled" { e = 1 }
        $1 == "Geometry:" { split($2, a, ","); split($3, s, "x"); g = a[2] " " s[2] }
        END { if (n && e) print n, g }' |
        awk -v sh=$STRIP_HEIGHT '$1 !~ /^eDP/ { line[NR] = $0; if ($1 !~ /^Virtual/ && row == "") row = $2 }
            END { for (i in line) { split(line[i], f, " "); if (f[2] == row && f[3] != sh) c++ } print c + 0 }'
}

# The glasses' own output: "name width wide-mode narrow-mode" (mode ids, or -).
# In 3D the glasses take a double-wide picture (3840 across); 2D is 1920.
glasses() {
    timeout 10 kscreen-doctor -o 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | python3 -c '
import re, sys
for b in re.split(r"(?m)^Output:\s*", sys.stdin.read())[1:]:
    name = b.split()[1]
    if name.startswith(("eDP", "Virtual")):
        continue
    g = re.search(r"Geometry:\s*-?\d+,-?\d+\s+(\d+)x\d+", b)
    modes = re.findall(r"(\d+):(\d+)x\d+@[\d.]+([*!]*)", b)
    wide = [m[0] for m in modes if int(m[1]) >= 3000]
    narrow = sorted((m for m in modes if int(m[1]) < 3000), key=lambda m: "!" not in m[2])
    print(name, g.group(1) if g else 0, wide[0] if wide else "-", narrow[0][0] if narrow else "-")
    break'
}
is3d() { local g; read -ra g <<< "$(glasses)"; (( ${g[1]:-0} >= 3000 )); }

# driver stop|start: let go of the glasses and take them back. Its own user
# service if it has one, otherwise the driver's disable switch.
driver() {
    if systemctl --user cat xr-driver.service >/dev/null 2>&1; then
        systemctl --user "$1" xr-driver.service
    elif [[ $1 == stop ]]; then
        "$HOME/.local/bin/xr_driver_cli" -d >/dev/null 2>&1
    else
        "$HOME/.local/bin/xr_driver_cli" -e >/dev/null 2>&1
    fi
}

# set_dimension 3d|2d. The Linux driver can't switch a Beast into 3D, and while
# it runs the glasses ignore their own buttons, so the driver lets go of them
# for a moment and you double-press R1. Whether they switched can't be seen
# from here (a Beast in 3D still takes a normal-width picture and splits it),
# so 3D is asked for, before anything changes, while the screen is still 2D
# and readable. Sets $sbs (mode for the viewer) and $in3d.
in3d=0
set_dimension() {
    local want=$1 secs=15 g
    if [[ $want == 3d ]]; then
        local text="When you press OK, double-press R1 on the glasses to switch them to 3D (you'll have $secs seconds). If they don't react, unplug and replug them."
        if command -v kdialog >/dev/null; then
            kdialog --title "Throne viewer" --yes-label "OK" --no-label "Stay in 2D" --yesno "$text" || { sbs=mono; return; }
        else
            note "$text"; sleep 5
        fi
    else
        (( in3d )) || return 0
    fi
    driver stop
    for _ in $(seq 10); do pgrep -f xrDriver >/dev/null || break; sleep 1; done
    note "Double-press R1 on the glasses now: ${want^^} ($secs s)"
    sleep "$secs"
    driver start
    for _ in $(seq 20); do  # head tracking back
        [[ -f $IMU ]] && (( $(date +%s) - $(stat -c %Y "$IMU") <= 2 )) && break
        sleep 1
    done
    if [[ $want == 3d ]]; then
        in3d=1
        # Some glasses take a double-wide picture in 3D: use it if they offer one.
        read -ra g <<< "$(glasses)"
        if [[ ${g[2]:--} != - ]]; then
            timeout 10 kscreen-doctor "output.${g[0]}.mode.${g[2]}" >/dev/null 2>&1; sleep 2
        fi
        if is3d; then sbs=sbs; else sbs=hsbs; fi
    else
        in3d=0
        read -ra g <<< "$(glasses)"  # back to the normal picture for Breezy
        is3d && [[ ${g[3]:--} != - ]] && timeout 10 kscreen-doctor "output.${g[0]}.mode.${g[3]}" >/dev/null 2>&1
    fi
}

mkdir -p "$WORK"
screens=$(row_count)
BREEZY_LAYOUT=$WORK/layout.json "$libexec/layout" save >/dev/null

restore() {
    trap - EXIT INT TERM
    kill "$server" 2>/dev/null
    set_dimension 2d  # Breezy wants the normal picture
    echo "Putting Breezy back…"
    kwin /Effects org.kde.kwin.Effects.loadEffect breezy_desktop >/dev/null
    systemctl --user start breezy-auto-screens.service
    # Wait for Breezy to be up again (its D-Bus API) and the widget strip back.
    for _ in $(seq 30); do
        kwin /com/xronlinux/BreezyDesktop com.xronlinux.BreezyDesktop.ListVirtualDisplays >/dev/null 2>&1 && break
        sleep 1
    done
    sleep 4
    for _ in 1 2; do
        (( $(row_count) < screens )) && { "$libexec/screens" more >/dev/null; sleep 3; }
    done
    BREEZY_LAYOUT=$WORK/layout.json setsid "$libexec/layout" place >/dev/null 2>&1 &
    note "Back to the desktop."
}
trap restore EXIT INT TERM

# Hand the glasses' screen over: no Breezy scene, and no stray Deck screen
# (stopping auto-screens turns it on).
systemctl --user stop breezy-auto-screens.service
kwin /Effects org.kde.kwin.Effects.unloadEffect breezy_desktop >/dev/null
sleep 1
timeout 10 kscreen-doctor output.eDP-1.disable >/dev/null 2>&1
set_dimension 3d

"$libexec/throne-server" "$url" $PORT &
server=$!
sleep 0.5
start="http://127.0.0.1:$PORT/v/?head=1&mode=${sbs:-hsbs}&lockmode=1"

if flatpak info org.mozilla.firefox >/dev/null 2>&1; then
    # Its own profile and instance (--no-remote), so it opens in kiosk mode even
    # if Firefox is already open, without first-run pages.
    mkdir -p "$PROFILE"
    cat > "$PROFILE/user.js" <<'EOF'
user_pref("browser.aboutwelcome.enabled", false);
user_pref("browser.shell.checkDefaultBrowser", false);
user_pref("browser.startup.homepage_override.mstone", "ignore");
user_pref("browser.sessionstore.resume_from_crash", false);
user_pref("datareporting.policy.dataSubmissionPolicyBypassNotification", true);
user_pref("toolkit.telemetry.reportingpolicy.firstRun", false);
user_pref("full-screen-api.warning.timeout", 0);
user_pref("browser.tabs.warnOnClose", false);
EOF
    flatpak run org.mozilla.firefox --no-remote --profile "$PROFILE" --kiosk "$start"
else
    for app in com.google.Chrome org.chromium.Chromium com.brave.Browser; do
        if flatpak info $app >/dev/null 2>&1; then
            dir=$HOME/.var/app/$app/breezy-throne-profile  # somewhere its sandbox can write
            mkdir -p "$dir"
            flatpak run $app --user-data-dir="$dir" --kiosk --no-first-run "$start"
            exit
        fi
    done
    note "No Firefox or Chrome (Flatpak) found; open $start in a browser and make it fullscreen."
    wait "$server"
fi
