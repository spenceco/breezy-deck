#!/bin/bash
# Rotate the screens in the Breezy Desktop view: "right" moves every window one
# screen left (and "left" one screen right), as if the view turned towards the
# next screen; windows on the end screen wrap to the other end, and the cursor
# returns to the middle screen. The screens are all the same size, so this
# looks like the screens reordering. The Deck's own screen (eDP) is left out.
#   breezy rotate right|left
case $1 in
    right) step=-1 ;;
    left) step=1 ;;
    *) echo "usage: breezy rotate right|left" >&2; exit 2 ;;
esac

. "$(dirname "$0")/kwin-script.sh"
run_kwin_script breezy_rotate <<JS
const step = $step;
const n = screens.length;
if (n >= 2) {
    // Decide every move first, so a window is never moved twice.
    const moves = [];
    for (const w of workspace.windowList()) {
        if (!w.normalWindow || w.deleted) continue;
        const i = screens.indexOf(w.output);
        if (i >= 0) moves.push([w, screens[(i + step + n) % n]]);
    }
    for (const [w, target] of moves) workspace.sendClientToScreen(w, target);

    const middle = screens[Math.floor(n / 2)];
    focusMiddle(moves.filter(([w, target]) => target === middle).map(([w]) => w));
}
JS
