#!/usr/bin/env bash
# Adds Breezy Desktop virtual screens once the glasses are connected and
# calibrated, then the widget strip above them (see "breezy widgets"). Windows
# are left where they are; "breezy layout restore" puts back a saved layout.
# The Deck's own screen is turned off while the glasses are connected: it
# isn't shown in them, so a cursor that strayed onto it was lost. The panel is
# kept on the middle (third) screen.
# Run as "breezy auto-screens" by the breezy-auto-screens user service.
COUNT=${BREEZY_SCREENS:-4}  # plus the glasses' own screen = 5
WIDTH=${BREEZY_SCREEN_WIDTH:-1920}
HEIGHT=${BREEZY_SCREEN_HEIGHT:-1080}
STATE=/dev/shm/xr_driver_state
MAX_TRIES=3  # times per plug-in to (re)add screens Breezy dropped

breezy() {
    gdbus call --session --dest org.kde.KWin \
        --object-path /com/xronlinux/BreezyDesktop \
        --method "com.xronlinux.BreezyDesktop.$1" "${@:2}"
}

state() { sed -n "s/^$1=//p" "$STATE" 2>/dev/null; }

# Connected when the driver names a device and its heartbeat (written every
# second) is fresh; a frozen driver counts as disconnected.
connected() {
    local beat
    beat=$(state heartbeat)
    [[ -n $(state connected_device_brand) && $beat =~ ^[0-9]+$ ]] &&
        (( $(date +%s) - beat < 10 ))
}

# The glasses' picture is on an external connector (DP-1). Their USB parts can
# show up without it (e.g. through a dock whose USB-C port carries no video);
# then the Deck's screen must stay on, or nothing is visible at all.
glasses_display() {
    grep -qx connected /sys/class/drm/card*-{DP,HDMI}-*/status 2>/dev/null
}

# "x name enabled priority y" for every output.
outputs() {
    timeout 10 kscreen-doctor -o 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | awk '
        /^Output:/ { if (n) print x, n, e, p, y; n = $3; e = 0; p = 0; x = 0; y = 0 }
        $1 == "enabled" { e = 1 }
        $1 == "priority" { p = $2 }
        $1 == "Geometry:" { split($2, a, ","); x = a[1]; y = a[2] + 0 }
        END { if (n) print x, n, e, p, y }'
}

# Make the middle (third) screen from the left the primary one, so the panel (with the
# app menu) sits there.
panel_on_middle_screen() {
    local x name enabled priority
    # Only the row level with the glasses' own screen, not the widget screen above it.
    read -r x name enabled priority < <(outputs | awk '
        { line[NR] = $0; split($0, f); if (f[3] == 1 && f[2] !~ /^(eDP|Virtual)/) row = f[5] }
        END { for (i = 1; i <= NR; i++) { split(line[i], f); if (f[3] == 1 && f[2] !~ /^eDP/ && f[5] == row) print line[i] } }' |
        sort -n | sed -n 3p)
    [[ -n $name && $priority != 1 ]] || return 0
    timeout 10 kscreen-doctor "output.$name.priority.1" >/dev/null 2>&1 && echo "Moved the panel to $name"
}

# Ready once connected glasses show a picture and have finished calibrating.
ready() { connected && glasses_display && [[ $(state calibration_state) == CALIBRATED ]]; }

# kscreen-doctor can hang while screens change (seen on reconnect): time it out.
builtin_screen() { timeout 10 kscreen-doctor "output.eDP-1.$1" >/dev/null 2>&1; }

# KWin turns the screen back on by itself when screens are added, so check it.
builtin_on() {
    timeout 10 kscreen-doctor -o 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' |
        awk '/^Output:/ {on_edp = $3 == "eDP-1"} on_edp && $1 == "enabled" {found = 1} END {exit !found}'
}

no_screens() { [[ $(breezy ListVirtualDisplays) == "(@av [],)" ]]; }

tries=0  # adds done for this connection
while sleep 2; do
    if connected && glasses_display; then
        builtin_on && builtin_screen disable && echo "Turned the Deck's screen off"
        panel_on_middle_screen
    else
        builtin_on || { builtin_screen enable && echo "Turned the Deck's screen on"; }
    fi
    if ! ready; then
        (( tries )) && echo "Glasses disconnected or recalibrating"
        tries=0
        continue
    fi
    (( tries >= MAX_TRIES )) && continue
    no_screens || { (( tries )) || tries=$MAX_TRIES; continue; }  # already set up
    sleep 3  # let Breezy settle after calibrating
    ready || continue
    tries=$((tries + 1))
    for ((i = 0; i < COUNT; i++)); do
        breezy AddVirtualDisplay "$WIDTH" "$HEIGHT" >/dev/null
    done
    echo "Added $COUNT ${WIDTH}x${HEIGHT} virtual screens (try $tries)"
    sleep 5
    if no_screens; then
        echo "Breezy dropped the screens; will try again"
        continue
    fi
    "$(dirname "$0")/widgets"  # the widget strip above the middle screen
done
