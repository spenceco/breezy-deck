#!/bin/bash
# Save what the glasses show (their own output: the screens, widgets and
# background as you see them) to ~/Pictures/Glasses. Spectacle captures every
# screen at once, and the glasses' part is cropped out of that.
#   breezy screenshot
dir=$HOME/Pictures/Glasses
out=$dir/glasses-$(date +%Y%m%d-%H%M%S).png
tmp=$(mktemp --suffix=.png)
trap 'rm -f "$tmp"' EXIT

# "name x y width height" for every enabled output.
outputs() {
    timeout 10 kscreen-doctor -o 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | awk '
        /^Output:/ { if (n && e) print n, g; n = $3; e = 0; g = "" }
        $1 == "enabled" { e = 1 }
        $1 == "Geometry:" { split($2, a, ","); split($3, s, "x"); g = a[1] " " a[2] " " s[1] " " s[2] }
        END { if (n && e) print n, g }'
}
# The full capture starts at the top-left corner of all the enabled screens.
read -r x y w h < <(outputs | awk '
    { if (NR == 1 || $2 < mx) mx = $2; if (NR == 1 || $3 < my) my = $3 }
    $1 !~ /^(eDP|Virtual)/ { gx = $2; gy = $3; gw = $4; gh = $5 }
    END { if (gw) print gx - mx, gy - my, gw, gh }')
if [[ -z $w ]]; then
    notify-send -a Breezy "No glasses screenshot" "The glasses aren't connected."
    exit 1
fi

mkdir -p "$dir"
timeout 20 spectacle --background --nonotify --fullscreen --output "$tmp" >/dev/null 2>&1 &&
    ffmpeg -loglevel error -y -i "$tmp" -vf "crop=$w:$h:$x:$y" "$out" || {
    notify-send -a Breezy "Glasses screenshot failed"
    exit 1
}
notify-send -a Breezy -i "$out" "Glasses screenshot saved" "${out/#$HOME/\~}"
echo "$out"
