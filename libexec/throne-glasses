#!/usr/bin/env python3
"""Drive VITURE glasses directly for "breezy throne": 3D on, head tracking out.

  throne-glasses <pose-file> [--fake]

The XR driver forces a Beast into 2D whenever it connects (and its buttons are
dead meanwhile), and won't switch it to 3D. So while the throne viewer runs,
the driver is stopped and this talks to the glasses through VITURE's SDK (the
libglasses.so the driver installed):

* turns off the glasses' own anchoring (0DoF), so it doesn't fight the
  viewer's head tracking, and switches the picture to 3D side-by-side;
* streams the glasses' orientation into <pose-file>, in the same block layout
  as the driver's /dev/shm/breezy_desktop_imu, so throne-server reads it as is;
* on exit (SIGTERM/SIGINT) puts the glasses back as they were.

--fake writes a slowly turning pose instead (for testing without glasses).
Needs LD_LIBRARY_PATH to include the driver's lib folder (throne sets it).
"""
import ctypes as C
import glob
import math
import os
import signal
import struct
import sys
import threading
import time

VENDOR = 0x35CA
LIB_DIRS = [os.path.expanduser("~/.local/share/xr_driver/lib"), "/usr/lib/xr_driver"]
DIAGONAL_FOV = 53.0          # the Beast's, as in the driver's device table
LOOK_AHEAD_MS = 10.0
# SDK constants (viture_protocol_public.h)
IMU_MODE_POSE = 1
IMU_FREQS = [3, 2, 1, 0]     # 240, 120, 90, 60 Hz
DOF_0 = 0

stop = threading.Event()


def log(*a):
    print("throne-glasses:", *a, file=sys.stderr, flush=True)


# ---------------------------------------------------------------- the pose block
def block(q0, q1, t0_ms, t1_ms):
    """Driver-format block (see throne-server): NWU quaternions as x, y, z, w."""
    d = bytearray()
    d += bytes([5, 1])                                        # version, enabled
    d += struct.pack("<4f", LOOK_AHEAD_MS, 1.0, 0.0, 0.0)     # look-ahead config
    d += struct.pack("<2I", 1920, 1080)                       # per-eye resolution
    d += struct.pack("<2f", DIAGONAL_FOV, 0.05)               # fov, lens distance ratio
    d += bytes([1, 0, 0])                                     # sbs, banner, smooth follow
    d += struct.pack("<16f", *([0.0] * 16))                   # smooth-follow origin
    d += struct.pack("<3f", 0.0, 0.0, 0.0)                    # position
    date = struct.pack("<Q", int(time.time() * 1000))
    rows = struct.pack("<16f", *q0, *q1, 0.0, 0.0, 0.0, 1.0, t0_ms, t1_ms, 0.0, 0.0)
    parity = 0
    for b in date + rows:
        parity ^= b
    return bytes(d) + date + rows + bytes([parity])


class PoseWriter:
    def __init__(self, path):
        self.path, self.prev, self.last_write = path, None, 0.0
        self.lock = threading.Lock()

    def put(self, q, t_ms):
        with self.lock:
            prev = self.prev or (q, t_ms - 4.0)
            self.prev = (q, t_ms)
            now = time.monotonic()
            if now - self.last_write < 1 / 300:   # plenty for the viewer
                return
            self.last_write = now
            data = block(q, prev[0], t_ms, prev[1])
            tmp = self.path + ".tmp"
            with open(tmp, "wb") as f:
                f.write(data)
            os.replace(tmp, self.path)            # readers never see half a block


# ---------------------------------------------------------------- the SDK
def find_product_id():
    for dev in glob.glob("/sys/bus/usb/devices/*"):
        try:
            with open(dev + "/idVendor") as f:
                if int(f.read(), 16) != VENDOR:
                    continue
            with open(dev + "/idProduct") as f:
                return int(f.read(), 16)
        except (OSError, ValueError):
            continue
    return None


def load_sdk():
    for d in LIB_DIRS:
        path = os.path.join(d, "libglasses.so")
        if os.path.exists(path):
            lib = C.CDLL(path)
            break
    else:
        raise SystemExit("VITURE SDK (libglasses.so) not found in " + ", ".join(LIB_DIRS))
    H = C.c_void_p
    sig = {
        "xr_device_provider_create": (H, [C.c_int]),
        "xr_device_provider_is_product_id_valid": (C.c_int, [C.c_int]),
        "xr_device_provider_initialize": (C.c_int, [H, C.c_char_p, C.c_char_p]),
        "xr_device_provider_start": (C.c_int, [H]),
        "xr_device_provider_stop": (C.c_int, [H]),
        "xr_device_provider_shutdown": (C.c_int, [H]),
        "xr_device_provider_destroy": (None, [H]),
        "xr_device_provider_get_device_type": (C.c_int, [H]),
        "xr_device_provider_is_product_support_native_dof": (C.c_int, [C.c_int]),
        "xr_device_provider_native_get_mode": (C.c_int, [H]),
        "xr_device_provider_native_get_dof": (C.c_int, [H]),
        "xr_device_provider_native_set_dof": (C.c_int, [H, C.c_int]),
        "xr_device_provider_native_get_display_mode": (C.c_int, [H]),
        "xr_device_provider_native_set_display_mode": (C.c_int, [H, C.c_int]),
        "xr_device_provider_native_switch_dimension": (C.c_int, [H, C.c_int]),
        "xr_device_provider_native_set_mode": (C.c_int, [H, C.c_int]),
        "xr_device_provider_get_display_mode": (C.c_int, [H]),
        "xr_device_provider_set_display_mode": (C.c_int, [H, C.c_int]),
        "xr_device_provider_switch_dimension": (C.c_int, [H, C.c_int]),
        "xr_device_provider_open_imu": (C.c_int, [H, C.c_uint8, C.c_uint8]),
        "xr_device_provider_close_imu": (C.c_int, [H, C.c_uint8]),
        "xr_device_provider_register_imu_pose_callback": (C.c_int, [H, C.c_void_p]),
    }
    for name, (res, args) in sig.items():
        fn = getattr(lib, name)
        fn.restype, fn.argtypes = res, args
    return lib


POSE_CB = C.CFUNCTYPE(None, C.POINTER(C.c_float), C.c_uint64)
RAW_CB = C.CFUNCTYPE(None, C.POINTER(C.c_float), C.c_uint64, C.c_uint64)
IMU_MODE_RAW = 0


class Mahony:
    """Gyro + gravity orientation filter, in three.js axes (x right, y up, z back).

    Raw samples come in the glasses' EDN frame (x right, y down, z forward;
    gyro in rad/s), as the driver documents. Which way the accelerometer
    points at rest is learned from the first samples (the glasses are upright
    when you put them on), so a sign convention can't turn the world over."""
    KP, KI = 1.0, 0.02

    def __init__(self):
        self.q = [1.0, 0.0, 0.0, 0.0]     # w, x, y, z
        self.bias = [0.0, 0.0, 0.0]
        self.t = None
        self.acc_sign = None
        self.warm = []

    def update(self, g, a, t_s):
        g = (g[0], -g[1], -g[2])          # EDN -> EUS
        a = (a[0], -a[1], -a[2])
        if self.acc_sign is None:         # learn "up" from the first ~0.2 s
            self.warm.append(a)
            if len(self.warm) < 40:
                self.t = t_s
                return None
            self.acc_sign = 1.0 if sum(v[1] for v in self.warm) > 0 else -1.0
            log("accelerometer sign", self.acc_sign)
        dt = t_s - self.t if self.t is not None else 0.0
        self.t = t_s
        if not 0 < dt < 0.1:
            return self.q
        w, x, y, z = self.q
        ax, ay, az = (self.acc_sign * v for v in a)
        n = math.sqrt(ax * ax + ay * ay + az * az)
        gx, gy, gz = g
        if n > 1e-6:
            ax, ay, az = ax / n, ay / n, az / n
            # world "up" (0, 1, 0) seen from the head
            vx = 2 * (x * y + w * z)
            vy = w * w - x * x + y * y - z * z
            vz = 2 * (y * z - w * x)
            ex, ey, ez = ay * vz - az * vy, az * vx - ax * vz, ax * vy - ay * vx
            self.bias = [b + self.KI * e * dt for b, e in zip(self.bias, (ex, ey, ez))]
            gx += self.KP * ex + self.bias[0]
            gy += self.KP * ey + self.bias[1]
            gz += self.KP * ez + self.bias[2]
        h = 0.5 * dt
        w, x, y, z = (w - h * (x * gx + y * gy + z * gz), x + h * (w * gx + y * gz - z * gy),
                      y + h * (w * gy - x * gz + z * gx), z + h * (w * gz + x * gy - y * gx))
        n = math.sqrt(w * w + x * x + y * y + z * z)
        self.q = [w / n, x / n, y / n, z / n]
        return self.q


def eus_to_nwu(q):
    """(w, x, y, z) in three.js axes -> (x, y, z, w) NWU, the block's layout."""
    w, ex, ey, ez = q
    return (-ez, -ex, ey, w)


def other_drivers():
    found = []
    for d in glob.glob("/proc/[0-9]*"):
        try:
            with open(d + "/cmdline", "rb") as f:
                cmd = f.read().replace(b"\0", b" ").decode(errors="replace")
        except OSError:
            continue
        if "xrDriver" in cmd and str(os.getpid()) not in d:
            found.append(d.split("/")[-1] + " " + cmd.strip())
    return found


def run_glasses(writer):
    lib = load_sdk()
    for extra, res, args in (("xr_device_provider_register_imu_raw_callback", C.c_int, [C.c_void_p, C.c_void_p]),
                             ("xr_device_provider_is_product_support_imu_frequency", C.c_int, [C.c_int, C.c_int, C.c_int])):
        fn = getattr(lib, extra); fn.restype, fn.argtypes = res, args
    for o in other_drivers():
        log("WARNING: another driver still has the glasses:", o)
    pid = find_product_id()
    if pid is None or lib.xr_device_provider_is_product_id_valid(pid) != 1:
        raise SystemExit(f"no supported VITURE glasses found (product id {pid})")
    h = lib.xr_device_provider_create(pid)
    if not h:
        raise SystemExit("couldn't open the glasses (is the XR driver still running?)")
    native_dof = lib.xr_device_provider_is_product_support_native_dof(pid) == 1
    log(f"product 0x{pid:04x}, device type {lib.xr_device_provider_get_device_type(h)}, native DoF support {native_dof}")

    # Head tracking: raw sensors + our own filter (what the driver does for these
    # glasses); the SDK's ready-made pose as a fallback. Callbacks are registered
    # before initialize, as the driver does.
    fusion = Mahony()

    def on_raw(data, ts, vsync):
        q = fusion.update((data[0], data[1], data[2]), (data[3], data[4], data[5]), ts / 1e9)
        if q:
            writer.put(eus_to_nwu(q), (ts / 1e6) % 1e6)

    def on_pose(data, ts):  # [roll, pitch, yaw, w, x, y, z], NWU
        writer.put((data[4], data[5], data[6], data[3]), (ts / 1e6) % 1e6)
    raw_cb, pose_cb = RAW_CB(on_raw), POSE_CB(on_pose)  # referenced for as long as the SDK may call them
    lib.xr_device_provider_register_imu_raw_callback(h, C.cast(raw_cb, C.c_void_p))
    lib.xr_device_provider_register_imu_pose_callback(h, C.cast(pose_cb, C.c_void_p))

    r = lib.xr_device_provider_initialize(h, None, None)
    if r != 0:
        raise SystemExit(f"couldn't initialize the glasses (error {r})")

    def state():
        n = lib.xr_device_provider_native_get_mode(h) if native_dof else 0
        if n == 1:
            return n, lib.xr_device_provider_native_get_display_mode(h), lib.xr_device_provider_native_get_dof(h)
        return n, lib.xr_device_provider_get_display_mode(h), -1

    def is_sbs(st):
        n, mode, _ = st
        return mode in ((0x37, 0x38, 0x39, 0x3A, 0x3B, 0x3C) if n == 1 else (0x32, 0x35, 0x42, 0x45))

    def show(st):
        return "native mode %d, display mode 0x%02x, dof %d" % (st[0], st[1] & 0xff, st[2])

    before = state()
    log("before:", show(before))
    saved = {"native": before[0], "display": before[1], "dof": before[2]}

    def try_3d(when):
        st = state()
        native = st[0] == 1
        attempts = []
        if native:
            attempts += [("native 0DoF", lambda: lib.xr_device_provider_native_set_dof(h, DOF_0)),
                         ("native switch_dimension(3D)", lambda: lib.xr_device_provider_native_switch_dimension(h, 1)),
                         ("native display mode 3D 3840x1200@60", lambda: lib.xr_device_provider_native_set_display_mode(h, 0x3A)),
                         ("native display mode 3D 3840x1080@60", lambda: lib.xr_device_provider_native_set_display_mode(h, 0x37))]
        attempts += [("switch_dimension(3D)", lambda: lib.xr_device_provider_switch_dimension(h, 1)),
                     ("display mode 3840x1200@60", lambda: lib.xr_device_provider_set_display_mode(h, 0x42)),
                     ("display mode 3840x1080@60", lambda: lib.xr_device_provider_set_display_mode(h, 0x32))]
        if native_dof and not native:   # the Beast's own 3D lives in native mode
            attempts += [("native mode", lambda: lib.xr_device_provider_native_set_mode(h, 1)),
                         ("native 0DoF", lambda: lib.xr_device_provider_native_set_dof(h, DOF_0)),
                         ("native switch_dimension(3D)", lambda: lib.xr_device_provider_native_switch_dimension(h, 1)),
                         ("native display mode 3D 3840x1080@60", lambda: lib.xr_device_provider_native_set_display_mode(h, 0x37))]
        accepted = False
        for name, fn in attempts:
            r = fn()
            time.sleep(0.5)
            st = state()
            log(f"[{when}] {name} -> {r}; now {show(st)}")
            if is_sbs(st):
                log("3D side-by-side is on")
                return True
            if r == 0 and "3D" in name:
                # accepted: the display may take a moment to change (and to say so)
                accepted = True
                for i in range(8):
                    time.sleep(0.5)
                    st = state()
                    if is_sbs(st):
                        log(f"[{when}] 3D side-by-side is on after {0.5 * (i + 2):.1f} s")
                        return True
                log(f"[{when}] {name}: accepted, but after 4.5 s the glasses still report {show(st)}")
                return "accepted"
        return accepted and "accepted"

    # The driver switches with the provider stopped ("fails while streaming").
    ok = try_3d("before start")
    time.sleep(1)  # as the driver does before start
    r = lib.xr_device_provider_start(h)
    if r != 0:
        raise SystemExit(f"couldn't start the glasses (error {r})")
    if ok is not True:
        ok = try_3d("after start") or ok
    if ok == "accepted":
        log("the glasses accepted the 3D command but don't report a 3D mode; keeping 3D anyway")
    elif not ok:
        log("no 3D mode took")

    opened = None
    for mode, label in ((IMU_MODE_RAW, "raw"), (IMU_MODE_POSE, "pose")):
        for freq in IMU_FREQS:
            if lib.xr_device_provider_is_product_support_imu_frequency(pid, mode, freq) != 1:
                continue
            r = lib.xr_device_provider_open_imu(h, mode, freq)
            log(f"open_imu({label}, frequency index {freq}) -> {r}")
            if r == 0:
                opened = mode
                break
        if opened is not None:
            break
    if opened is None:
        log("couldn't open head tracking")
    # for throne: whether 3D and head tracking came up (they're decided separately)
    with open(writer.path + ".state", "w") as f:
        f.write(f"3d={int(bool(ok))} imu={int(opened is not None)}\n")

    print("ready", flush=True)
    while not stop.wait(0.5):
        pass

    if opened is not None:
        lib.xr_device_provider_close_imu(h, opened)
    lib.xr_device_provider_stop(h)
    # back as they were: the mode family first, then its display mode and anchoring
    if saved["native"] == 1:
        lib.xr_device_provider_native_set_mode(h, 1)
        if saved["display"] >= 0:
            lib.xr_device_provider_native_set_display_mode(h, saved["display"])
        if saved["dof"] >= 0:
            lib.xr_device_provider_native_set_dof(h, saved["dof"])
    else:
        if native_dof:
            lib.xr_device_provider_native_set_mode(h, 0)
        lib.xr_device_provider_switch_dimension(h, 0)
        if saved["display"] >= 0:
            lib.xr_device_provider_set_display_mode(h, saved["display"])
    log("after:", show(state()))
    log("glasses put back")
    lib.xr_device_provider_shutdown(h)
    lib.xr_device_provider_destroy(h)


def run_fake(writer):
    with open(writer.path + ".state", "w") as f:
        f.write("3d=1 imu=1\n")
    print("ready", flush=True)
    t0 = time.time()
    while not stop.wait(0.004):
        t = time.time() - t0
        yaw = math.radians(20 * math.sin(t / 2))   # look left and right
        q = (0.0, 0.0, math.sin(yaw / 2), math.cos(yaw / 2))
        writer.put(q, (t * 1000) % 1e6)


def main():
    if len(sys.argv) < 2:
        raise SystemExit("usage: throne-glasses <pose-file> [--fake]")
    writer = PoseWriter(sys.argv[1])
    for s in (signal.SIGTERM, signal.SIGINT):
        signal.signal(s, lambda *_: stop.set())
    (run_fake if "--fake" in sys.argv else run_glasses)(writer)


if __name__ == "__main__":
    main()
