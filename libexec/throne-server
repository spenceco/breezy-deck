#!/usr/bin/env python3
"""Local helper for "breezy throne": head tracking for the stereo skybox viewer.

  throne-server <viewer-url> [port]

* /v/...   the viewer, fetched from <viewer-url> and cached in
           ~/.cache/breezy-throne, so it also works offline once seen. Serving
           it from here keeps the page and the head data on one origin (no
           mixed-content or private-network blocks in the browser).
* /v/local/...  files from ~/.local/share/breezy-deck/throne (your own
           panoramas and videos), with byte ranges so videos can stream.
* /pose    the glasses' head orientation as a Server-Sent Events stream, read
           from the XR driver's shared memory (the same block Breezy reads).
* /status  the last pose block, decoded, as JSON (for checking by hand).

Only the standard library, so it runs on SteamOS as it is.
"""
import json
import mimetypes
import os
import struct
import sys
import threading
import time
import urllib.parse
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

IMU = os.environ.get("BREEZY_IMU", "/dev/shm/breezy_desktop_imu")
CACHE = os.path.expanduser("~/.cache/breezy-throne")
LOCAL = os.path.expanduser("~/.local/share/breezy-deck/throne")

# Until the viewer plays videos itself: let a .mp4/.webm environment be a
# looping, muted video texture. Patched into index.html as it's served; each
# replacement is skipped if its text isn't there (e.g. once the viewer does it).
VIDEO_PATCH = [
    ("function loadEnv(url) {\n  clearEnv();\n", """// video panoramas (added by breezy-deck's throne-server): a looping, muted video as the texture
function loadVideoEnv(url) {
  return new Promise((res, rej) => {
    const v = document.createElement('video');
    Object.assign(v, { loop: true, muted: true, playsInline: true, preload: 'auto', crossOrigin: 'anonymous' });
    v.addEventListener('loadeddata', () => {
      const t = new THREE.VideoTexture(v);
      t.mapping = THREE.EquirectangularReflectionMapping;
      t.colorSpace = THREE.SRGBColorSpace;
      envTex = t; buildGroundedSky(); v.play().catch(() => {}); res();
    }, { once: true });
    v.addEventListener('error', e => { msg(`couldn't load video: ${url}`); rej(e); }, { once: true });
    v.src = url;
  });
}

function loadEnv(url) {
  clearEnv();
  if (/\\.(mp4|webm|mkv)([?#]|$)/i.test(url || '')) return loadVideoEnv(url);
"""),
    ("if (envTex) { envTex.dispose(); envTex = null; }", "if (envTex) { envTex.image?.pause?.(); envTex.dispose(); envTex = null; }"),
]
EXPECTED_VERSION = 5
RATE_HZ = 250

# Layout of the driver's block, as in Breezy's breezydesktopeffect.cpp
# (DataView): each field is (offset, size of one value, count).
def _layout():
    fields = [("version", 1, 1), ("enabled", 1, 1), ("look_ahead_cfg", 4, 4), ("display_res", 4, 2),
              ("display_fov", 4, 1), ("lens_distance_ratio", 4, 1), ("sbs_enabled", 1, 1),
              ("custom_banner_enabled", 1, 1), ("smooth_follow_enabled", 1, 1),
              ("smooth_follow_origin", 4, 16), ("pose_position", 4, 3), ("pose_date_ms", 4, 2),
              ("pose_orientation", 4, 16), ("parity", 1, 1)]
    out, off = {}, 0
    for name, size, count in fields:
        out[name] = (off, size * count)
        off += size * count
    return out, off

FIELDS, LENGTH = _layout()


def read_pose():
    """The decoded block, or None if it's missing, torn mid-write or the wrong size."""
    try:
        with open(IMU, "rb") as f:
            d = f.read()
    except OSError:
        return None
    if len(d) != LENGTH:
        return None
    o, n = FIELDS["pose_date_ms"]
    parity = 0
    for b in d[o:o + n]:
        parity ^= b
    o, n = FIELDS["pose_orientation"]
    for b in d[o:o + n]:
        parity ^= b
    if parity != d[FIELDS["parity"][0]]:
        return None

    def get(name, fmt):
        o, n = FIELDS[name]
        return struct.unpack_from("<" + fmt, d, o)

    q = get("pose_orientation", "16f")
    # NWU (driver) -> EUS (x right, y up, z back: three.js's axes), as Breezy does:
    # (x, y, z, w) = (-y, z, -x, w). Rows 0 and 1 are the two latest orientations,
    # row 3 holds their timestamps.
    def eus(i):
        x, y, z, w = q[4 * i:4 * i + 4]
        return [-y, z, -x, w]
    pos = get("pose_position", "3f")
    return {
        "version": d[0],
        "enabled": bool(d[1]),
        "lookAhead": list(get("look_ahead_cfg", "4f")),
        "res": list(get("display_res", "2I")),
        "fov": get("display_fov", "f")[0],
        "sbs": bool(d[FIELDS["sbs_enabled"][0]]),
        "t": get("pose_date_ms", "Q")[0],
        "q": eus(0),
        "q1": eus(1),
        "dt": q[12] - q[13],
        "pos": [-pos[1], pos[2], -pos[0]],
    }


class Handler(BaseHTTPRequestHandler):
    viewer_url = ""

    def log_message(self, fmt, *args):  # quiet: the stream would flood the journal
        pass

    def do_GET(self):
        path = urllib.parse.urlsplit(self.path).path
        if path == "/":
            self.send_response(302)
            self.send_header("Location", "/v/?mode=sbs&head=1")
            self.end_headers()
        elif path == "/pose":
            self.stream_pose()
        elif path == "/status":
            body = json.dumps(read_pose(), indent=1).encode()
            self.reply(200, body, "application/json")
        elif path.startswith("/v/local/"):
            self.serve_local(urllib.parse.unquote(path[len("/v/local/"):]))
        elif path.startswith("/v/"):
            self.serve_viewer(path[3:] or "index.html")
        else:
            self.reply(404, b"not found", "text/plain")

    def reply(self, code, body, ctype, extra=()):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        for k, v in extra:
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(body)

    def stream_pose(self):
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        last_t, last_send = None, 0.0
        try:
            while True:
                p = read_pose()
                now = time.time()
                if p and p["t"] != last_t:
                    last_t = p["t"]
                    p["age"] = now * 1000 - p["t"]
                    self.wfile.write(b"data: " + json.dumps(p, separators=(",", ":")).encode() + b"\n\n")
                    self.wfile.flush()
                    last_send = now
                elif now - last_send > 2:  # keep-alive, and lets the page see the driver went quiet
                    self.wfile.write(b": idle\n\n")
                    self.wfile.flush()
                    last_send = now
                time.sleep(1 / RATE_HZ)
        except (BrokenPipeError, ConnectionResetError):
            pass

    def serve_local(self, rel):
        full = os.path.realpath(os.path.join(LOCAL, rel))
        if not full.startswith(os.path.realpath(LOCAL) + os.sep) or not os.path.isfile(full):
            return self.reply(404, b"not found", "text/plain")
        size = os.path.getsize(full)
        start, end = 0, size - 1
        rng = self.headers.get("Range", "")
        if rng.startswith("bytes="):
            a, _, b = rng[6:].split(",")[0].partition("-")
            if a:
                start, end = int(a), min(int(b) if b else size - 1, size - 1)
            elif b:
                start = max(0, size - int(b))
            if start > end:
                self.send_response(416)
                self.send_header("Content-Range", f"bytes */{size}")
                self.end_headers()
                return
        self.send_response(206 if rng else 200)
        self.send_header("Content-Type", mimetypes.guess_type(full)[0] or "application/octet-stream")
        self.send_header("Accept-Ranges", "bytes")
        self.send_header("Content-Length", str(end - start + 1))
        if rng:
            self.send_header("Content-Range", f"bytes {start}-{end}/{size}")
        self.end_headers()
        try:
            with open(full, "rb") as f:
                f.seek(start)
                left = end - start + 1
                while left > 0:
                    chunk = f.read(min(1 << 20, left))
                    if not chunk:
                        break
                    self.wfile.write(chunk)
                    left -= len(chunk)
        except (BrokenPipeError, ConnectionResetError):
            pass

    def serve_viewer(self, rel):
        rel = os.path.normpath(urllib.parse.unquote(rel)).lstrip("/")
        if rel.startswith(".."):
            return self.reply(403, b"no", "text/plain")
        cached = os.path.join(CACHE, rel)
        body = None
        try:  # fresh copy when online, so changes to the viewer show up
            with urllib.request.urlopen(self.viewer_url + urllib.parse.quote(rel), timeout=10) as r:
                body = r.read()
            os.makedirs(os.path.dirname(cached), exist_ok=True)
            with open(cached + ".part", "wb") as f:
                f.write(body)
            os.replace(cached + ".part", cached)
        except Exception:
            if os.path.isfile(cached):
                with open(cached, "rb") as f:
                    body = f.read()
        if body is None:
            return self.reply(404, b"not found (and not cached)", "text/plain")
        ctype = mimetypes.guess_type(rel)[0] or "application/octet-stream"
        if rel == "index.html":
            text = body.decode("utf-8", "replace")
            for old, new in VIDEO_PATCH:
                if old in text:
                    text = text.replace(old, new, 1)
            body = text.encode()
        if rel.endswith(".js"):
            ctype = "text/javascript"
        self.reply(200, body, ctype)


def main():
    if len(sys.argv) < 2:
        sys.exit("usage: throne-server <viewer-url> [port]")
    url = sys.argv[1]
    Handler.viewer_url = url if url.endswith("/") else url + "/"
    port = int(sys.argv[2]) if len(sys.argv) > 2 else 8770
    server = ThreadingHTTPServer(("127.0.0.1", port), Handler)
    server.daemon_threads = True
    print(f"throne-server on http://127.0.0.1:{port}/ (viewer {Handler.viewer_url}, pose {IMU})", flush=True)
    server.serve_forever()


if __name__ == "__main__":
    main()
