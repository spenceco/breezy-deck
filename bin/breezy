#!/bin/bash
# breezy: Breezy Desktop (XR glasses) helpers for the Steam Deck. See README.md.
# Each subcommand is a script in ../libexec.
usage() {
    cat <<'EOF'
usage: breezy <command> [args]

  recenter                 recenter the view in the glasses
  center                   cursor and focus to the window on the middle screen
  rotate right|left        move every window one screen over (wrapping around)
  swap right|left          swap the active window with its neighbour's windows
  layout save|restore|place|show  which window is on which screen
  background [list|<name>|none|next|prev]  the picture behind the screens
  widgets                  add the widget strip above the middle screen
  screenshot               save what the glasses show to ~/Pictures/Glasses
  throne [<url>|stop]      the stereo skybox viewer in the glasses, head-tracked
  screens more|less        1, 3 or 5 screens: one more or fewer on each side
  screens arrange          line the screens up around the middle one
  screens add [n] [w] [h]  add n virtual screens (default 1, 1920x1080)
  screens list             list the virtual screens
  screens remove <id>      remove a virtual screen
  auto-screens             background job run by breezy-auto-screens.service
  taps                     background job run by breezy-taps.service
EOF
}

# VS Code's terminal runs in a Flatpak sandbox: run on the host instead.
if [[ -f /.flatpak-info ]]; then
    exec flatpak-spawn --host --directory="$HOME" "$(readlink -f "$0")" "$@"
fi

libexec=$(dirname "$(readlink -f "$0")")/../libexec
case $1 in
    recenter | center | rotate | swap | layout | background | widgets | screenshot | screens | throne | auto-screens | taps) exec "$libexec/$1" "${@:2}" ;;
    "" | help | -h | --help) usage ;;
    *) usage >&2; exit 2 ;;
esac
